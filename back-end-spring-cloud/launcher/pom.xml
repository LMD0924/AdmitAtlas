<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.admitatlas</groupId>
        <artifactId>admitatlas-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>admitatlas-launcher</artifactId>
    <name>AdmitAtlas Launcher</name>
    <description>全工程唯一可执行应用：唯一的启动类、唯一的 application.yml、唯一的可执行 jar</description>

    <dependencies>
        <!-- 聚合所有平铺的业务模块，它们都是普通 library jar -->
        <dependency>
            <groupId>com.admitatlas</groupId>
            <artifactId>admitatlas-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.admitatlas</groupId>
            <artifactId>admitatlas-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.admitatlas</groupId>
            <artifactId>admitatlas-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>com.admitatlas</groupId>
            <artifactId>admitatlas-auth-user</artifactId>
        </dependency>
        <dependency>
            <groupId>com.admitatlas</groupId>
            <artifactId>admitatlas-school</artifactId>
        </dependency>
        <dependency>
            <groupId>com.admitatlas</groupId>
            <artifactId>admitatlas-score</artifactId>
        </dependency>
        <dependency>
            <groupId>com.admitatlas</groupId>
            <artifactId>admitatlas-policy-rule</artifactId>
        </dependency>
        <dependency>
            <groupId>com.admitatlas</groupId>
            <artifactId>admitatlas-match-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>com.admitatlas</groupId>
            <artifactId>admitatlas-plan-report</artifactId>
        </dependency>
        <dependency>
            <groupId>com.admitatlas</groupId>
            <artifactId>admitatlas-data-collector</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Spring Cloud / Nacos 依赖保留但默认关闭：未来拆分微服务时按需启用 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 全工程只有这里打可执行 jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.admitatlas.AdmitAtlasApplication</mainClass>
                </configuration>
                <!-- repackage 由 spring-boot-starter-parent 默认绑定，不要重复声明 execution -->
            </plugin>
        </plugins>
    </build>
</project>
